{
  "nodes": [
    {
      "alias": "root",
      "types": [
        "Root"
      ],
      "properties": {
        "purpose": "Approval workflow: submit a request, suspend at the human checkpoint, resume with the same correlation ID to complete; a decision without a prior submission is rejected",
        "name": "tutorial-14"
      }
    },
    {
      "alias": "resume",
      "types": [
        "Resume"
      ],
      "properties": {
        "skill": "graph.resume",
        "task": "v1.redis.retrieve.model",
        "missing": "check-fresh",
        "purpose": "Restore workflow state if this transaction was suspended earlier"
      }
    },
    {
      "alias": "check-fresh",
      "types": [
        "Decision"
      ],
      "properties": {
        "skill": "graph.math",
        "statement": [
          "MAPPING: text(={input.body.decision}) -> model.decision_probe",
          "IF: {model.decision_probe} == '=null'\nTHEN: record-request\nELSE: reject"
        ],
        "purpose": "Input validation: a fresh transaction must be a submission - a decision without a suspended record is rejected"
      }
    },
    {
      "alias": "record-request",
      "types": [
        "Suspensible"
      ],
      "properties": {
        "skill": "graph.data.mapper",
        "suspend": true,
        "mapping": [
          "input.body -> model.request",
          "text(pending-approval) -> model.stage"
        ],
        "purpose": "Capture the submitted request, then suspend for approval"
      }
    },
    {
      "alias": "suspend",
      "types": [
        "Suspend"
      ],
      "properties": {
        "skill": "graph.suspend",
        "task": "v1.redis.persist.model",
        "ttl": "1h",
        "purpose": "Persist workflow state to Redis and wait for the approver"
      }
    },
    {
      "alias": "approve",
      "types": [
        "mapper"
      ],
      "properties": {
        "skill": "graph.data.mapper",
        "mapping": [
          "model.request -> output.body.request",
          "input.body.decision -> output.body.decision",
          "text(completed) -> output.body.stage"
        ],
        "purpose": "Complete the workflow with the approver decision and the original request"
      }
    },
    {
      "alias": "reject",
      "types": [
        "mapper"
      ],
      "properties": {
        "skill": "graph.data.mapper",
        "mapping": [
          "int(404) -> output.status",
          "text(rejected) -> output.body.type",
          "text(Transaction not found. Submit the request before sending a decision) -> output.body.message"
        ],
        "purpose": "Reject a decision that has no suspended transaction"
      }
    },
    {
      "alias": "end",
      "types": [
        "End"
      ],
      "properties": {}
    }
  ],
  "connections": [
    {
      "source": "root",
      "target": "resume",
      "relations": [
        {
          "type": "then",
          "properties": {}
        }
      ]
    },
    {
      "source": "resume",
      "target": "check-fresh",
      "relations": [
        {
          "type": "fresh",
          "properties": {}
        }
      ]
    },
    {
      "source": "check-fresh",
      "target": "record-request",
      "relations": [
        {
          "type": "submission",
          "properties": {}
        }
      ]
    },
    {
      "source": "check-fresh",
      "target": "reject",
      "relations": [
        {
          "type": "no-transaction",
          "properties": {}
        }
      ]
    },
    {
      "source": "record-request",
